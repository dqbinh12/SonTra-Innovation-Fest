HOST=0.0.0.0
PORT=1337

# Generate each of these with: openssl rand -base64 32
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Remote data transfer (`strapi transfer --to/--from`). Enabled by default;
# set to false to close the transfer websocket on this instance.
TRANSFER_REMOTE_ENABLED=true

# Database — sqlite for local development, postgres for staging/production.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Postgres (used when DATABASE_CLIENT=postgres)
# DATABASE_CLIENT=postgres
# DATABASE_HOST=db
# DATABASE_PORT=5432
# DATABASE_NAME=sif
# DATABASE_USERNAME=sif
# DATABASE_PASSWORD=
# DATABASE_SSL=false

# Where the public site lives — used to trigger ISR revalidation on publish.
SITE_URL=http://localhost:3000
REVALIDATE_SECRET=
