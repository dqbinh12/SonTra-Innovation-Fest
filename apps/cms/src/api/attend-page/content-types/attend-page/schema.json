{
  "kind": "singleType",
  "collectionName": "attend_pages",
  "info": {
    "singularName": "attend-page",
    "pluralName": "attend-pages",
    "displayName": "Attend Page",
    "description": "Why Attend hero, audience, benefits and free-entry info. heroMedia is the wide / desktop hero background; heroMediaMobile is the portrait crop used on phones (optional \u2014 falls back to heroMedia)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "heroTitle": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroBody": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroMedia": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "videos"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "heroMediaMobile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "videos"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "audience": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "audienceSegments": {
      "type": "component",
      "repeatable": true,
      "component": "attend.audience-segment",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "attend.benefit",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "entryInfo": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
