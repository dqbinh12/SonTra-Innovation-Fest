# Copy to infra/.env on the server and fill in. Never commit the filled file.
# Generate every secret with: openssl rand -base64 32

# --- Public URLs (must be the real domain in production) ---
NEXT_PUBLIC_SITE_URL=https://sontrainnovationfest.vn
NEXT_PUBLIC_STRAPI_URL=https://cms.sontrainnovationfest.vn

# --- Database ---
DATABASE_NAME=sif
DATABASE_USERNAME=sif
DATABASE_PASSWORD=

# --- Strapi secrets ---
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# --- Frontend <-> CMS ---
# Read-only token created in Strapi admin: Settings -> API Tokens.
STRAPI_API_TOKEN=
# Shared secret for the publish webhook that triggers ISR revalidation.
REVALIDATE_SECRET=
