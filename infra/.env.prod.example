# Copy to `.env` next to docker-compose.prod.yml on the server. Never commit it.
#
#   cp .env.example .env   # in infra/, then move it wherever you deploy
#   openssl rand -base64 32   # generate every secret (run once per value)
#
# Then:
#   docker compose -f docker-compose.prod.yml --env-file .env pull
#   docker compose -f docker-compose.prod.yml --env-file .env up -d

# Which GHCR build to run. Leave empty/default for :latest.
# Pin an exact CI build (or roll back) with, e.g.:
#   IMAGE_TAG=sha-a1b2c3d
IMAGE_TAG=latest

# --- Public URLs (must be the real domain in production) ---
NEXT_PUBLIC_SITE_URL=https://sontrainnovation.com
NEXT_PUBLIC_STRAPI_URL=https://cms.sontrainnovation.com

# --- Strapi secrets (all required; each must be freshly generated) ---
# APP_KEYS is a comma-separated list — generate four and join them.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# --- Frontend <-> CMS ---
# Read-only token created in Strapi admin: Settings -> API Tokens.
STRAPI_API_TOKEN=
# Shared secret for the publish webhook that triggers ISR revalidation.
REVALIDATE_SECRET=
